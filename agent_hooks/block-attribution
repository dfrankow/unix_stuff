#!/bin/bash

# Deny git commits and gh PR creates or edits whose message or body carries
# Claude Code attribution ("Generated with", "Co-Authored-By").
# Checks the command text and any message or body
# file it passes with --body-file, --file or -F.
#
# Reads the PreToolUse payload on stdin and prints a deny decision, or nothing.

set -uo pipefail

command="$(cat | jq -r '.tool_input.command // empty' 2>/dev/null)"
[ -z "$command" ] && exit 0

printf '%s' "$command" | grep -qE '(git( -C [^ ]+)? commit|gh (pr|api)[^|;&]*(create|edit|comments|replies))' || exit 0

pattern='Generated with|Co-Authored-By'

deny() {
  jq -n --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $reason
    }
  }'
  exit 0
}

reason="Remove the Claude Code attribution (\"Generated with\" / \"Co-Authored-By\") from the commit message or PR body."

printf '%s' "$command" | grep -qiE "$pattern" && deny "$reason"

files="$(printf '%s' "$command" | grep -oE -- '(--body-file|--file|-F)[ =]+[^ ;&|]+' | sed -E 's/^(--body-file|--file|-F)[ =]+//')"
while IFS= read -r file; do
  [ -z "$file" ] && continue
  file="${file%\"}"
  file="${file#\"}"
  file="${file%\'}"
  file="${file#\'}"
  file="${file/#\~/$HOME}"
  [ -f "$file" ] && grep -qiE "$pattern" "$file" && deny "$reason (found in $file)"
done <<< "$files"

exit 0
